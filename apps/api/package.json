{
  "name": "@execution-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "seed": "set -a && . ../../.env && set +a && tsx src/seed.ts",
    "migrate:clerk-user": "set -a && . ../../.env && set +a && tsx src/scripts/migrate-clerk-user.ts",
    "prisma:generate": "set -a && . ../../.env && set +a && prisma generate",
    "prisma:migrate": "set -a && . ../../.env && set +a && prisma migrate dev --name init",
    "prisma:db:push": "set -a && . ../../.env && set +a && prisma db push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@clerk/backend": "^3.10.0",
    "@execution-os/shared": "0.1.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^5.20.0",
    "@types/ws": "^8.18.1",
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.9.0",
    "openai": "^6.32.0",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
